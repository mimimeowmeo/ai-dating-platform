generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(uuid()) @db.Uuid
  email        String   @unique
  passwordHash String   @map("password_hash")
  isVerified   Boolean  @default(false) @map("is_verified")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")
  profile      Profile?
  preference   Preference?
  photos       Photo[]
  sessions     Session[]
  verifications Verification[]
  traits UserTrait[]
  sentInteractions Interaction[] @relation("sent")
  receivedInteractions Interaction[] @relation("received")
  matchesA Match[] @relation("matchA")
  matchesB Match[] @relation("matchB")
  blocks Block[] @relation("blocker")
  blockedBy Block[] @relation("blocked")
  members ConversationMember[]
  messages Message[]
  notifications Notification[]
  @@map("users")
}

model Session {
  id String @id @default(uuid()) @db.Uuid
  userId String @map("user_id") @db.Uuid
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String @unique @map("token_hash")
  previousTokenHash String? @unique @map("previous_token_hash")
  rotatedAt DateTime? @map("rotated_at")
  expiresAt DateTime @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime @default(now()) @map("created_at")
  @@index([userId])
  @@map("sessions")
}

model Trait {
  id Int @id @default(autoincrement())
  category String
  code String
  labelZh String? @map("label_zh")
  users UserTrait[]
  @@unique([category, code])
  @@map("traits")
}

model UserTrait {
  userId String @map("user_id") @db.Uuid
  traitId Int @map("trait_id")
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  trait Trait @relation(fields: [traitId], references: [id], onDelete: Restrict)
  @@id([userId, traitId])
  @@index([traitId])
  @@map("user_traits")
}

model Profile {
  userId String @id @map("user_id") @db.Uuid
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  displayName String @map("display_name")
  birthDate DateTime @map("birth_date") @db.Date
  gender String
  bio String @default("")
  city String
  latitude Float
  longitude Float
  // 舊欄位，已由 traits 的 dating_goal 取代；保留資料並給預設值，之後可移除。
  datingIntent String @default("serious") @map("dating_intent")
  heightCm Int? @map("height_cm")
  occupation String?
  education String?
  interests String[] @default([])
  hobbies String[] @default([])
  foods String[] @default([])
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  @@map("profiles")
}

model Preference {
  userId String @id @map("user_id") @db.Uuid
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  minAge Int @default(18) @map("min_age")
  maxAge Int @default(99) @map("max_age")
  preferredGender String @default("any") @map("preferred_gender")
  maxDistanceKm Int @default(100) @map("max_distance_km")
  minHeightCm Int @default(130) @map("min_height_cm")
  maxHeightCm Int @default(250) @map("max_height_cm")
  preferredDatingIntent String @default("any") @map("preferred_dating_intent")
  updatedAt DateTime @updatedAt @map("updated_at")
  @@map("preferences")
}

model Photo {
  id String @id @default(uuid()) @db.Uuid
  userId String @map("user_id") @db.Uuid
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  storageKey String @unique @map("storage_key")
  mimeType String @map("mime_type")
  isAvatar Boolean @default(false) @map("is_avatar")
  displayOrder Int @default(0) @map("display_order")
  createdAt DateTime @default(now()) @map("created_at")
  @@index([userId])
  @@map("user_photos")
}

model Verification {
  id String @id @default(uuid()) @db.Uuid
  userId String @map("user_id") @db.Uuid
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  storageKey String? @map("storage_key")
  mimeType String @map("mime_type")
  status String @default("pending")
  reasonCode String? @map("reason_code")
  modelName String? @map("model_name")
  modelVersion String? @map("model_version")
  livenessScore Float? @map("liveness_score")
  faceMatchScore Float? @map("face_match_score")
  createdAt DateTime @default(now()) @map("created_at")
  @@index([userId, createdAt])
  @@map("verification_records")
}

model Interaction {
  id String @id @default(uuid()) @db.Uuid
  fromUserId String @map("from_user_id") @db.Uuid
  toUserId String @map("to_user_id") @db.Uuid
  fromUser User @relation("sent", fields: [fromUserId], references: [id], onDelete: Cascade)
  toUser User @relation("received", fields: [toUserId], references: [id], onDelete: Cascade)
  action String
  createdAt DateTime @default(now()) @map("created_at")
  @@unique([fromUserId, toUserId])
  @@index([toUserId])
  @@map("likes")
}

model Match {
  id String @id @default(uuid()) @db.Uuid
  userAId String @map("user_a_id") @db.Uuid
  userBId String @map("user_b_id") @db.Uuid
  userA User @relation("matchA", fields: [userAId], references: [id], onDelete: Cascade)
  userB User @relation("matchB", fields: [userBId], references: [id], onDelete: Cascade)
  status String @default("active")
  createdAt DateTime @default(now()) @map("created_at")
  unmatchedAt DateTime? @map("unmatched_at")
  conversation Conversation?
  @@unique([userAId, userBId])
  @@map("matches")
}

model Block {
  id String @id @default(uuid()) @db.Uuid
  userId String @map("user_id") @db.Uuid
  blockedUserId String @map("blocked_user_id") @db.Uuid
  user User @relation("blocker", fields: [userId], references: [id], onDelete: Cascade)
  blockedUser User @relation("blocked", fields: [blockedUserId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now()) @map("created_at")
  @@unique([userId, blockedUserId])
  @@index([blockedUserId])
  @@map("blocks")
}

model Conversation {
  id String @id @default(uuid()) @db.Uuid
  matchId String @unique @map("match_id") @db.Uuid
  match Match @relation(fields: [matchId], references: [id], onDelete: Cascade)
  members ConversationMember[]
  messages Message[]
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  @@map("conversations")
}

model ConversationMember {
  conversationId String @map("conversation_id") @db.Uuid
  userId String @map("user_id") @db.Uuid
  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  joinedAt DateTime @default(now()) @map("joined_at")
  lastReadAt DateTime? @map("last_read_at")
  @@id([conversationId, userId])
  @@map("conversation_members")
}

model Message {
  id String @id @default(uuid()) @db.Uuid
  conversationId String @map("conversation_id") @db.Uuid
  senderId String @map("sender_id") @db.Uuid
  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender User @relation(fields: [senderId], references: [id], onDelete: Cascade)
  content String
  clientId String @map("client_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")
  @@unique([senderId, clientId])
  @@index([conversationId, createdAt])
  @@map("messages")
}

model Notification {
  id String @id @default(uuid()) @db.Uuid
  userId String @map("user_id") @db.Uuid
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  type String
  payload Json
  readAt DateTime? @map("read_at")
  createdAt DateTime @default(now()) @map("created_at")
  @@index([userId, createdAt])
  @@map("notifications")
}
