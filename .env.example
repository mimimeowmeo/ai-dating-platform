# 本機開發：先執行 pnpm setup，自動產生隨機密碼與連線字串。
# 已有 .env 時保留非空值；不要提交真實密碼。
# PostgreSQL 帳密只在空白資料卷首次初始化生效。
POSTGRES_DB=dating
POSTGRES_USER=dating
POSTGRES_PASSWORD=
POSTGRES_PORT=5432

# setup 會依上面的帳密產生 URL，含必要的 URL 編碼。
DATABASE_URL=
DOCKER_DATABASE_URL=
REDIS_URL=redis://127.0.0.1:6379
S3_ENDPOINT=http://127.0.0.1:9000
S3_ACCESS_KEY=dating-local
S3_SECRET_KEY=
S3_BUCKET=dating-media
JWT_SECRET=
AI_INTERNAL_URL=http://127.0.0.1:8000
AI_INTERNAL_TOKEN=
# 未設定時驗證如實回傳 unavailable，不會授予驗證標記。
AI_VERIFICATION_PROVIDER_URL=
AI_VERIFICATION_PROVIDER_TOKEN=
# AI 推薦回覆（見 docs/ai/REPLY-SUGGESTIONS-SPEC.md 第 10 節）。
# Google AI Studio 的 API key，所有向量化都要用；未設定時向量化回 503（不會假造結果），推薦只剩 Ollama、沒有備援。
GEMINI_API_KEY=
# 線上產生推薦的備援鏈（逗號分隔，依序嘗試）：平常用 Ollama Cloud，失敗、額度用完或太慢時改用 Gemini。
AI_REPLY_MODELS=ollama:gemma4:31b,gemini-3.8-flash
AI_REPLY_THINKING_LEVEL=LOW
# 備援鏈裡每個模型各自的逾時（秒）；要比 AI_LLM_TIMEOUT_SECONDS（整次請求，預設 25）短。
AI_REPLY_MODEL_TIMEOUT_SECONDS=12
# 背景萃取（摘要、風格卡）用 Ollama Cloud；key 在 https://ollama.com/settings/keys 建立。
# 想離線開發改用本機 Ollama 時：OLLAMA_BASE_URL=http://localhost:11434/v1、模型改成本機有的（例：ollama:gemma4:12b）。
AI_EXTRACTION_MODELS=ollama:gemma4:31b
OLLAMA_BASE_URL=https://ollama.com/v1
OLLAMA_API_KEY=
# 所有向量必須同一個模型與維度（pgvector 欄位是 vector(768)）。
AI_EMBEDDING_MODEL=gemini-embedding-2
AI_EMBEDDING_DIMENSIONS=768
WEB_ORIGIN=http://localhost:8080
APP_PORT=8080
PORT=3001
NODE_ENV=development
# 本機 HTTP 使用 false；部署 HTTPS 時改為 true。
COOKIE_SECURE=false
